# deepdig — provider API keys (copy to .env or set in MCP settings env block)
# Only the providers with a key are activated; the rest are skipped silently.

# Alibaba Cloud DashScope (Qwen web search)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# Zhipu AI (GLM web_search tool)
ZHIPU_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx

# Moonshot AI (Kimi $web_search builtin)
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxx

# Optional tuning
# DEEPDIG_TIMEOUT=8.0
# DEEPDIG_QWEN_MODEL=qwen-plus
# DEEPDIG_GLM_MODEL=glm-4-flash
# DEEPDIG_KIMI_MODEL=kimi-latest
